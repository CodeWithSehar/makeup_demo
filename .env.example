# Glow & Grace Storefront Configuration Template
# Copy this file to .env.local to customize your store contact and phone numbers locally.
# .env.local is ignored by git and will NEVER be uploaded to GitHub.

# Shop WhatsApp number in international format (e.g. 923001234567 without + or spaces)
VITE_SHOP_WHATSAPP_NUMBER=923434113012

# Shop Customer Care phone number
VITE_SHOP_PHONE=0343-4113012

# Shop Email
VITE_SHOP_EMAIL=concierge@glowandgrace.pk

